# Google AI Studio API key used by the server for Gemini chat/storyboards and Veo.
GEMINI_API_KEY=
PORT=3001
GEMINI_MODEL=gemini-3.8-flash

# Override this only with a Veo model ID enabled for your Google account.
VEO_MODEL=veo-3.1-lite-generate-preview

# In-memory generation queue and operation timeout.
MAX_QUEUED_VIDEO_JOBS=3
VIDEO_GENERATION_TIMEOUT_MS=600000
